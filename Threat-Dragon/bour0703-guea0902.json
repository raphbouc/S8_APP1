            "id": "general-survey-api",
            "data": {
              "type": "tm.Process",
              "name": "GeneralSurvey API",
              "description": "API REST ASP.NET Core responsable de l'authentification, de la validation des réponses et de la gestion des sondages.",
              "outOfScope": false,
              "isTrustBoundary": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "isWebApplication": true,
              "privilegeLevel": "Application",
              "threats": [
                {
                  "status": "Mitigated",
                  "severity": "High",
                  "title": "Contournement de l'authentification API",
                  "type": "Spoofing",
                  "description": "Un attaquant pourrait tenter d'accéder aux fonctionnalités de l'API sans fournir une clé API valide.",
                  "mitigation": "Le middleware ApiKeyMiddleware vérifie X-API-Key avant d'autoriser l'accès aux contrôleurs."
                },
                {
                  "status": "Mitigated",
                  "severity": "High",
                  "title": "Soumission de réponses invalides",
                  "type": "Tampering",
                  "description": "Un client malveillant pourrait modifier le contenu d'une réponse ou ajouter des réponses qui ne correspondent pas au sondage.",
                  "mitigation": "L'API vérifie que le sondage existe, que toutes les questions sont présentes, qu'elles sont uniques et que chaque réponse correspond à une option valide."
                },
                {
                  "status": "Open",
                  "severity": "Medium",
                  "title": "Déni de service par requêtes répétées",
                  "type": "Denial of service",
                  "description": "Un attaquant pourrait envoyer un grand nombre de requêtes afin de consommer les ressources de l'API ou du système de fichiers.",
                  "mitigation": "Ajouter éventuellement une limitation du nombre de requêtes par client et surveiller les accès anormaux."
                },
                {
                  "status": "Mitigated",
                  "severity": "Medium",
                  "title": "Élévation des privilèges",
                  "type": "Elevation of privilege",
                  "description": "Un participant pourrait tenter d'utiliser une fonctionnalité réservée à un client API autorisé.",
                  "mitigation": "L'API distingue l'authentification du client avec X-API-Key de l'authentification du participant avec X-Participant-Key."
                }
              ]
            }
